    <inertial>
      <origin xyz="-0.015 0 0"/>
      <mass value="0.097"/>
      <inertia ixx="0.000070529" ixy="0" ixz="0" iyy="0.000012327" iyz="0" izz="0.000072750"/>
    </inertial>
  </link>
  <joint name="gripper_to_wrist_camera" type="fixed">
    <parent link="gripper_base"/>
    <child link="wrist_camera_link"/>
    <origin rpy="0 -1.2249803973515843 0" xyz="-0.055 0 0.0308"/>
  </joint>
  <link name="wrist_camera_optical_frame"/>
  <joint name="wrist_camera_optical_joint" type="fixed">
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
  </joint>
  <gazebo reference="gripper_to_wrist_camera">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="wrist_camera_link">
    <!-- Retain existing ideal robot gravity compensation in simulation. -->
    <gravity>false</gravity>
    <sensor name="wrist_rgbd_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <!-- Registered depth uses the RGB 4:3 view (63 degrees), not native IR FOV. -->
        <horizontal_fov>1.09955742876</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="wrist_rgbd_camera_controller">
        <ros>
          <namespace>/wrist_camera</namespace>
        </ros>
        <camera_name>wrist_camera</camera_name>
        <frame_name>wrist_camera_optical_frame</frame_name>
        <!-- RGB can see nearby fingers; valid Gemini 2 depth begins at 150 mm. -->
        <min_depth>0.15</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
