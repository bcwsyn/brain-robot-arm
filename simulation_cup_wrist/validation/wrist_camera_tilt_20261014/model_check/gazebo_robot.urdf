  <link name="wrist_camera_link">
    <!-- Camera axes are +X forward, +Y along the 90 mm body, +Z along its 25 mm height. -->
    <visual>
      <origin xyz="-0.015 0 0"/>
      <geometry>
        <box size="0.030 0.090 0.025"/>
      </geometry>
      <material name="gemini2_housing">
        <color rgba="0.82 0.84 0.86 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.0005 0 0"/>
      <geometry>
        <box size="0.001 0.082 0.021"/>
      </geometry>
      <material name="gemini2_front">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="0.0012 -0.026 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.004"/>
      </geometry>
      <material name="gemini2_glass">
        <color rgba="0.10 0.22 0.30 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="0.0012 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.004"/>
      </geometry>
