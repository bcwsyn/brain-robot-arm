<?xml version="1.0"?>
<sdf version="1.7">
  <model name="care_floor">
    <static>true</static>
    <link name="floor_link">
      <collision name="floor_collision">
        <pose>0 0 {floor_center_z} 0 0 0</pose>
        <geometry>
          <box><size>{floor_size} {floor_size} {floor_thickness}</size></box>
        </geometry>
      </collision>
      <visual name="floor_visual">
        <pose>0 0 {floor_center_z} 0 0 0</pose>
        <geometry>
          <box><size>{floor_size} {floor_size} {floor_thickness}</size></box>
        </geometry>
        <material>
          <ambient>0.58 0.60 0.63 1</ambient>
          <diffuse>0.68 0.70 0.73 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
