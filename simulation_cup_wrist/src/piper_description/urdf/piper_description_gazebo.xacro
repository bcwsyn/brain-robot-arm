      <material>Gazebo/Orange</material>
  </gazebo> -->

  <ros2_control name="GazeboSystem" type="system">
      <hardware>
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <joint name="joint1">
          <xacro:physics_pid kp="2000" kd="30" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint2">
          <xacro:physics_pid kp="3000" kd="40" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint3">
          <xacro:physics_pid kp="2000" kd="25" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint4">
          <xacro:physics_pid kp="100" kd="0.3" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint5">
          <xacro:physics_pid kp="300" kd="1.0" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint6">
          <xacro:physics_pid kp="30" kd="0.05" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint7">
          <xacro:physics_pid kp="$(arg physics_jaw_kp)" kd="$(arg physics_jaw_kd)" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
      <joint name="joint8">
          <xacro:physics_pid kp="$(arg physics_jaw_kp)" kd="$(arg physics_jaw_kd)" />
          <command_interface name="position">
              <param name="min">-1</param>
              <param name="max">1</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
      </joint>
  </ros2_control>

<!-- gazebo -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters> $(find piper_gazebo)/config/ros2_controllers.yaml </parameters>
        <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
 
</robot>
